<Project>
  <PropertyGroup>
    <!-- The release version: bump this, and merging to main tags and publishes vX.Y.Z.
         CI passes a pre-release VersionSuffix for pull request builds (pr.12.34 -> 0.1.0-pr.12.34). -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Composed here rather than left to the SDK, so every project body sees the final Version. -->
    <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
  </PropertyGroup>
</Project>
