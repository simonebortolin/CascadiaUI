<Project>
  <PropertyGroup>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <DotNetTfm>net10.0</DotNetTfm>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Assembly / package metadata shared by every project. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Simone Bortolin</Authors>
    <Company>Simone Bortolin</Company>
    <Product>CascadiaUI</Product>
    <Copyright>Copyright (c) Simone Bortolin</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/simonebortolin/CascadiaUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/simonebortolin/CascadiaUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
