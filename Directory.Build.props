<Project>
  <Import Project="BuildVersion.props" />

  <PropertyGroup>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <DotNetTfm>net10.0</DotNetTfm>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Assembly / package metadata shared by every project. -->
  <PropertyGroup>
    <Authors>Simone Bortolin</Authors>
    <Company>Simone Bortolin</Company>
    <Product>CascadiaUI</Product>
    <Copyright>Copyright (c) Simone Bortolin</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/simonebortolin/CascadiaUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/simonebortolin/CascadiaUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Keep the product version clean ("0.1.0"), without the "+<commit sha>" SourceLink suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
