<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cascadia="https://github.com/simonebortolin/CascadiaUI"
             xmlns:vm="using:CascadiaUI.Gallery.ViewModels"
             x:Class="CascadiaUI.Gallery.Views.TabsPage"
             x:DataType="vm:TabsPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24" Spacing="24">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Tabs" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="The window itself uses title-bar tabs. Below: the macOS-style pills used for in-page navigation, and Terminal-style document tabs you can close, add and drag to reorder." />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="h3" Text="Pills (Classes=&quot;pills&quot;)" />
        <TabControl Classes="pills">
          <TabItem Header="Image"><TextBlock Classes="secondary" Text="Image tab content" /></TabItem>
          <TabItem Header="Text"><TextBlock Classes="secondary" Text="Text tab content" /></TabItem>
          <TabItem Header="Barcode"><TextBlock Classes="secondary" Text="Barcode tab content" /></TabItem>
          <TabItem Header="QR"><TextBlock Classes="secondary" Text="QR tab content" /></TabItem>
          <TabItem Header="Draw" />
          <TabItem Header="DIN rail" />
          <TabItem Header="Compose" />
          <TabItem Header="History" />
          <TabItem Header="About" />
        </TabControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="h3" Text="Document tabs (CascadiaTabControl)" />
        <cascadia:CascadiaTabControl Height="220"
                                     CornerRadius="10"
                                     BorderThickness="1"
                                     CanCloseTabs="True"
                                     ShowAddButton="True"
                                     ItemsSource="{Binding Documents}"
                                     SelectedItem="{Binding SelectedDocument}"
                                     AddTabCommand="{Binding AddDocumentCommand}"
                                     CloseTabCommand="{Binding CloseDocumentCommand}">
          <cascadia:CascadiaTabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DocumentTab">
              <TextBlock Text="{Binding Header}" />
            </DataTemplate>
          </cascadia:CascadiaTabControl.ItemTemplate>
          <cascadia:CascadiaTabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:DocumentTab">
              <StackPanel Margin="20" Spacing="6">
                <TextBlock Classes="h3" Text="{Binding Header}" />
                <TextBlock Classes="secondary mono" Text="General&#10;Format        : Matroska&#10;File size     : 4.12 GiB" />
              </StackPanel>
            </DataTemplate>
          </cascadia:CascadiaTabControl.ContentTemplate>
        </cascadia:CascadiaTabControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Classes="h3" Text="Classic TabControl in a card" />
        <TabControl CornerRadius="10" BorderThickness="1" Height="140">
          <TabItem Header="Settings"><TextBlock Margin="20" Classes="secondary" Text="Plain TabControl, same Terminal look." /></TabItem>
          <TabItem Header="About"><TextBlock Margin="20" Classes="secondary" Text="About page" /></TabItem>
          <TabItem Header="Disabled" IsEnabled="False" />
        </TabControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
