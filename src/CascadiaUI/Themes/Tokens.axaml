      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource CascadiaControlStrokeStrongColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource CascadiaControlStrokeStrongColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource CascadiaControlFillColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource CascadiaControlFillHoverColor}" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource CascadiaControlFillPressedColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundIndeterminate" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="CheckBoxForegroundIndeterminatePointerOver" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource CascadiaControlStrokeStrongColor}" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource CascadiaControlStrokeStrongColor}" />
      <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{StaticResource CascadiaControlFillColor}" />
      <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{StaticResource CascadiaControlFillHoverColor}" />

      <!-- Accent used as text (links, hyperlinks) - deepened on light backgrounds -->
      <SolidColorBrush x:Key="CascadiaAccentTextBrush" Color="{DynamicResource SystemAccentColorDark1}" />
      <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{DynamicResource SystemAccentColorDark1}" />
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{DynamicResource SystemAccentColorDark2}" />
      <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{DynamicResource SystemAccentColorDark3}" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="CascadiaWindowBackgroundColor">#1F1F1F</Color>
      <Color x:Key="CascadiaTitleBarBackgroundColor">#161616</Color>
      <Color x:Key="CascadiaSurfaceColor">#272727</Color>
      <Color x:Key="CascadiaSurfaceSecondaryColor">#2B2B2B</Color>
      <Color x:Key="CascadiaCardColor">#2C2C2C</Color>
      <Color x:Key="CascadiaCardStrokeColor">#383838</Color>
      <Color x:Key="CascadiaControlFillColor">#323232</Color>
      <Color x:Key="CascadiaControlFillHoverColor">#3A3A3A</Color>
      <Color x:Key="CascadiaControlFillPressedColor">#2C2C2C</Color>
      <Color x:Key="CascadiaControlFillDisabledColor">#2A2A2A</Color>
      <Color x:Key="CascadiaControlStrokeColor">#424242</Color>
      <Color x:Key="CascadiaControlStrokeStrongColor">#555555</Color>
      <Color x:Key="CascadiaDividerColor">#373737</Color>
      <Color x:Key="CascadiaTextPrimaryColor">#EDEDED</Color>
      <Color x:Key="CascadiaTextSecondaryColor">#ABABAB</Color>
      <Color x:Key="CascadiaTextTertiaryColor">#808080</Color>
      <Color x:Key="CascadiaTextDisabledColor">#5F5F5F</Color>
      <Color x:Key="CascadiaSubtleHoverColor">#14FFFFFF</Color>
      <Color x:Key="CascadiaSubtlePressedColor">#0BFFFFFF</Color>
      <Color x:Key="CascadiaPopupColor">#2C2C2C</Color>
