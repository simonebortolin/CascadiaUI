      <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="{StaticResource CascadiaTextSecondaryColor}" />
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource CascadiaPopupColor}" />
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="{StaticResource CascadiaPopupStrokeColor}" />
