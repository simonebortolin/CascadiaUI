      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource CascadiaPopupStrokeColor}" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource CascadiaCardColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{StaticResource CascadiaCardColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{StaticResource CascadiaCardColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="{StaticResource CascadiaControlFillDisabledColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderForegroundDisabled" Color="{StaticResource CascadiaTextDisabledColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{StaticResource CascadiaCardStrokeColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="{StaticResource CascadiaCardStrokeColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="{StaticResource CascadiaCardStrokeColor}" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushDisabled" Color="{StaticResource CascadiaDividerColor}" />
      <SolidColorBrush x:Key="ExpanderChevronForeground" Color="{StaticResource CascadiaTextSecondaryColor}" />
      <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="{StaticResource CascadiaTextPrimaryColor}" />
      <SolidColorBrush x:Key="ExpanderChevronForegroundPressed" Color="{StaticResource CascadiaTextSecondaryColor}" />
      <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="{StaticResource CascadiaSubtleHoverColor}" />
      <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="{StaticResource CascadiaSubtlePressedColor}" />
      <SolidColorBrush x:Key="ExpanderContentBackground" Color="{StaticResource CascadiaSurfaceSecondaryColor}" />
      <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="{StaticResource CascadiaCardStrokeColor}" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{StaticResource CascadiaSubtleHoverColor}" />
